	/// Actual minus planned volume in hl, summed only where a forecast exists. Positive means above plan; missing forecasts are not estimated.
	measure 'Deviation hl' = EXTERNALMEASURE("Deviation hl", CURRENCY, "DirectQuery to AS - 3fa9b173-f000-4529-a4f7-00d0d6a8d136/f3dd4c43-1c47-408c-92af-af5bea6fd78c")
