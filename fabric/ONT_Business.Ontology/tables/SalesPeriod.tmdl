	/// Planned beverage volume in hectolitres (hl). Blank if no forecast exists for the selection.
	measure 'Forecast hl' = EXTERNALMEASURE("Forecast hl", CURRENCY, "DirectQuery to AS - 3fa9b173-f000-4529-a4f7-00d0d6a8d136/f3dd4c43-1c47-408c-92af-af5bea6fd78c")
