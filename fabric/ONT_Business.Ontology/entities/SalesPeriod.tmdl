/// Monthly beverage sales and forecasts at product, package, region, channel, and nullable partner grain. Delivery data stays separate.
entity SalesPeriod
	lineageTag: 7cefb675-8de3-432d-8c41-78bbe2e44669
	backingTable: SalesPeriod

	/// First day of the sales or forecast month.
	property Month
		dataType: dateTime
		lineageTag: 30629caa-8c07-49bb-bf1b-e1fdb205b749

		backingConfiguration
			valueColumn: SalesPeriod.Month

		synonym month

		synonym period

	/// Product key; SKU digits are legacy codes, not package sizes.
	property 'Product Code'
		dataType: string
		lineageTag: 4ca95405-c3ef-42bf-ac8c-3e964ed79ecc

		backingConfiguration
			valueColumn: SalesPeriod.'Product Code'

		synonym 'product code'

		synonym sku

	/// Package key, also called Gebinde.
	property 'Package Code'
		dataType: string
		lineageTag: 56866bc4-6bd4-476f-89f8-b22dbc8afb97

		backingConfiguration
			valueColumn: SalesPeriod.'Package Code'

		synonym 'package code'

		synonym Gebinde

		synonym package

	/// Sales channel key, also called Kanal.
	property 'Channel Code'
		dataType: string
		lineageTag: fc0f43b3-e182-47fa-bb14-91493bb3ff10

		backingConfiguration
			valueColumn: SalesPeriod.'Channel Code'

		synonym 'channel code'

		synonym Kanal

		synonym channel

	/// Sales region key.
	property 'Region Code'
		dataType: string
		lineageTag: cb838437-5bc1-4b42-876b-bee133aa38ae

		backingConfiguration
			valueColumn: SalesPeriod.'Region Code'

		synonym 'region code'

		synonym region

	/// Sold beverage volume in hectolitres (hl). Reuses the SM_Sales 'Actual hl' measure semantics.
	property 'Actual Volume'
		dataType: decimal
		lineageTag: f5c3c0c3-1fc5-4397-a120-ce9381ac76b1

		backingConfiguration
			valueColumn: SalesPeriod.'Actual Volume'

		synonym hl

		synonym hectolitre

		synonym volume

		synonym 'actual hl'

	/// Planned beverage volume in hectolitres (hl). Reuses the SM_Sales 'Forecast hl' measure semantics.
	property 'Forecast Volume'
		dataType: decimal
		lineageTag: f91f39ba-f362-4d84-902f-d421e9df5233

		backingConfiguration
			valueColumn: SalesPeriod.'Forecast Volume'

		synonym hl

		synonym hectolitre

		synonym volume

		synonym 'forecast hl'

	/// Actual minus planned volume in hectolitres (hl). Reuses the SM_Sales 'Deviation hl' measure semantics.
	property 'Deviation Volume'
		dataType: decimal
		lineageTag: 495200e4-61b2-4408-b3a3-2edb53167e61

		backingConfiguration
			valueColumn: SalesPeriod.'Deviation Volume'

		synonym hl

		synonym hectolitre

		synonym volume

		synonym 'deviation hl'

		synonym variance

	/// Net sales revenue in EUR. Reuses the SM_Sales 'Revenue EUR' measure semantics.
	property Revenue
		dataType: decimal
		lineageTag: ba0bbd65-b0cf-48f0-a7a0-a343b3f7bf8f

		backingConfiguration
			valueColumn: SalesPeriod.Revenue

		synonym 'revenue eur'

		synonym 'sales revenue'

		synonym EUR

	/// Contribution margin in EUR. Reuses the SM_Sales 'Margin EUR' measure semantics.
	property Margin
		dataType: decimal
		lineageTag: 66bb01c5-5d11-4b12-b371-624d9151694f

		backingConfiguration
			valueColumn: SalesPeriod.Margin

		synonym 'margin eur'

		synonym 'contribution margin'

